{$TABLESIGHT_DOMAIN:localhost} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}

	# Manager web app: static files only; same origin as the API (web/app.js uses API = "")
	@webapp path / /index.html /app.css /app.js /i18n.json
	handle @webapp {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		root * /srv/web
		file_server
	}

	# Everything else is the JSON API (it sets its own strict default-src 'none' CSP)
	handle {
		reverse_proxy api:8080
	}
}
